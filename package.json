{
  "name": "shortline-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:native": "cmake -S . -B build-native -DCMAKE_BUILD_TYPE=Release && cmake --build build-native --parallel 4",
    "build:wasm": "emcmake cmake -S . -B build-wasm -DCMAKE_BUILD_TYPE=Release && cmake --build build-wasm --parallel 4",
    "build": "npm run build:native && npm run build:wasm && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint web",
    "test": "node --test tests/*.test.mjs",
    "golden": "node tools/verify-golden.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0"
  }
}
